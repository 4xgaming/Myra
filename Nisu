name: Nisu AI APK Build

on:
  workflow_dispatch:
  push:
    paths:
      - 'nisu-v3_181-speed-core.zip'
      - '.github/workflows/android.yml'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract Nisu AI source
        run: |
          unzip -q nisu-v3_181-speed-core.zip -d source
          test -f source/proj/settings.gradle.kts
          test -f source/proj/app/build.gradle.kts

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK 35
        run: |
          sdkmanager "platforms;android-35" "build-tools;35.0.0"
          yes | sdkmanager --licenses

      - name: Build debug APK
        working-directory: source/proj
        run: |
          gradle assembleDebug --no-daemon --stacktrace

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: Nisu-AI-v3.181-debug-APK
          path: source/proj/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 14
